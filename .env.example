# Required for the protected /feedback/stats endpoint.
ADMIN_API_TOKEN=replace-with-a-long-random-token

# Required for POST /feedback. Use the same value in the Android build.
FEEDBACK_API_TOKEN=replace-with-a-different-long-random-token

# Optional. Defaults to data/feedback.db.
# FEEDBACK_DB_PATH=D:/path/to/feedback.db
